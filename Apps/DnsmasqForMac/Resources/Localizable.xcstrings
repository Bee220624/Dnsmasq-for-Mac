    "Connect a USB or Thunderbolt Ethernet adapter. Wi-Fi and the interface carrying this Mac's internet connection cannot be used.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接 USB 或 Thunderbolt 以太网卡。Wi-Fi 以及承载本机互联网连接的接口不可使用。"
          }
        }
      }
    },
    "Connect to the privileged helper to see engine details.": {
