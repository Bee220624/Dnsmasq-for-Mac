    "Development build. The helper enforces the same caller verification as a release build.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发版本。helper 执行与正式版本完全相同的调用方校验。"
          }
        }
      }
    },
    "Devices on the network you connect to will take addresses from Dnsmasq for Mac instead of from their usual DHCP server.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所连接网络中的设备将从 Dnsmasq for Mac 获取地址，而不再从原本的 DHCP 服务器获取。"
          }
        }
      }
    },
    "Disabled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用"
          }
        }
      }
    },
    "Discard Changes": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃更改"
          }
        }
      }
    },
    "Dismiss": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Dnsmasq for Mac bundles dnsmasq by Simon Kelley as a separate, unmodified program. No dnsmasq code is compiled or linked into Dnsmasq for Mac itself.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnsmasq for Mac 以独立且未经修改的程序形式附带 Simon Kelley 的 dnsmasq。Dnsmasq for Mac 自身不编译或链接任何 dnsmasq 代码。"
          }
        }
      }
    },
    "Dnsmasq for Mac does not collect analytics, upload logs, or send network configuration to external services.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnsmasq for Mac 不收集分析数据、不上传日志，也不会将网络配置发送到外部服务。"
          }
        }
      }
    },
    "Dnsmasq for Mac needs a privileged helper": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnsmasq for Mac 需要一个特权 helper"
          }
        }
      }
    },
    "Dnsmasq for Mac services are still running.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnsmasq for Mac 的服务仍在运行。"
          }
        }
      }
    },
    "Dnsmasq for Mac will not be able to start any service until the helper is installed again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在重新安装 helper 之前，Dnsmasq for Mac 将无法启动任何服务。"
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
