    },
    "Duplicate": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "Editable DHCP and DNS forms are added in a later phase. The values from the selected profile are used as-is.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可编辑的 DHCP 与 DNS 表单将在后续阶段加入。当前直接使用所选配置中的值。"
          }
        }
      }
    },
    "Empty the view. The log file on disk is not changed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清空视图，磁盘上的日志文件不受影响。"
