    "If you quit without stopping, DHCP and DNS keep running and the temporary IP address stays on the interface until you start Dnsmasq for Mac again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若直接退出，DHCP 与 DNS 将继续运行，临时 IP 地址也会保留在接口上，直到你再次打开 Dnsmasq for Mac。"
          }
        }
      }
    },
    "Incompatible": {
      "extractionState": "manual",
      "localizations": {
