// Base.xcconfig — settings shared by every target and configuration.

#include "Identifiers.xcconfig"

// ---- Platform -------------------------------------------------------------------------
MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = $(ARCHS_STANDARD)

// ---- Swift ----------------------------------------------------------------------------
SWIFT_VERSION = 6.0
// Ticket §3.2: strict concurrency checking is mandatory.
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

// ---- Warnings -------------------------------------------------------------------------
// Ticket §Phase 1: warnings are errors for project source. dnsmasq is built entirely
// outside Xcode by Scripts/build-dnsmasq.sh, so no third-party C is affected by this.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
GCC_WARN_UNDECLARED_SELECTOR = YES
CLANG_ENABLE_OBJC_WEAK = YES
GCC_NO_COMMON_BLOCKS = YES

// ---- Hardening ------------------------------------------------------------------------
ENABLE_HARDENED_RUNTIME = YES
CLANG_ENABLE_MODULE_VERIFIER = NO
DEAD_CODE_STRIPPING = YES

// ---- Signing --------------------------------------------------------------------------
CODE_SIGN_STYLE = Manual
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO

// ---- Versioning -----------------------------------------------------------------------
MARKETING_VERSION = $(APP_VERSION)
CURRENT_PROJECT_VERSION = $(APP_BUILD)

// ---- Misc -----------------------------------------------------------------------------
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
COMBINE_HIDPI_IMAGES = YES
